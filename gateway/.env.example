# OpenContext Gateway configuration. Copy to gateway/.env (never commit the copy).
# Every variable is optional: `npm start` works out of the box with in-memory storage.

# ---- Server ---------------------------------------------------------------
NODE_ENV=development            # development | staging | production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info                  # error | warn | info | debug

# ---- Storage --------------------------------------------------------------
# Unset => in-memory storage (data is lost on restart). Set for persistence / multi-worker mode.
# REDIS_URL=redis://localhost:6379

# ---- Payments (Superfluid on Base) ----------------------------------------
# The gateway never holds user keys. It builds unsigned CFAv1Forwarder calldata for the
# client to sign and verifies the resulting flow on-chain before serving metered traffic.
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
# Super USDC (USDCx) on Base and the CFAv1Forwarder, from @superfluid-finance/metadata + tokenlist.
SUPER_TOKEN_ADDRESS=0xD04383398dD2426297da660F9CCA3d439AF9ce1b
CFA_FORWARDER_ADDRESS=0xcfA132E353cB4E398080B9700609bb008eceB125

# ---- Upstream partner credentials -----------------------------------------
# When set, the gateway injects the credential into proxied requests and strips any
# client-supplied Authorization header. When unset, the client's own Authorization header
# (or apiKey query parameter) is forwarded unchanged.
# NEWSAPI_KEY=
# GITHUB_TOKEN=
# SATELLITE_API_KEY=

# ---- GitHub OAuth (optional; /auth/github/* return 503 when unset) --------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_MAX=100              # per client IP
RATE_LIMIT_WINDOW=1 minute
PASSPORT_RATE_LIMIT_MAX=1000    # per X-Passport-ID, per minute
SKIP_RATE_LIMITING=false

# ---- CORS -----------------------------------------------------------------
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# ---- Clustering (npm run start:cluster) -----------------------------------
ENABLE_CLUSTERING=true
# WORKER_COUNT=4                # defaults to the CPU count
CLUSTER_MANAGEMENT_PORT=3002
