{
  "name": "@opencontext/gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Metered HTTP proxy for AI agents: per-passport usage metering, Superfluid stream verification, chunked large-file transfers and DePIN inference routing",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/proxy.ts",
    "start:cluster": "tsx src/server.ts",
    "start:single": "ENABLE_CLUSTERING=false tsx src/server.ts",
    "dev": "tsx watch src/proxy.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7",
    "lru-cache": "^11.5.3",
    "pino-pretty": "^13.2.0",
    "redis": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.12.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
