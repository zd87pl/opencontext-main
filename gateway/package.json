{
  "name": "@opencontext/gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/proxy.ts",
    "start:cluster": "tsx src/server.ts",
    "start:single": "ENABLE_CLUSTERING=false tsx src/server.ts",
    "dev": "tsx watch src/proxy.ts",
    "dev:cluster": "tsx watch src/server.ts",
    "build": "tsup",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "lint": "echo 'No linter configured for gateway yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "http-proxy-middleware": "^3.0.0",
    "ethers": "^6.13.1",
    "@superfluid-finance/sdk-core": "^0.6.16",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.6.0",
    "validator": "^13.12.0",
    "isomorphic-dompurify": "^2.14.0",
    "lru-cache": "^10.2.2",
    "redis": "^4.6.13",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "tsx": "^4.15.7",
    "tsup": "^8.1.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.14.8"
  }
}