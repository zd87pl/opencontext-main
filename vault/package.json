{
  "name": "@opencontext/vault",
  "version": "0.1.0",
  "description": "A user-owned, encrypted, portable memory for your AI agents, as a local MCP server.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "bin": { "opencontext-vault": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "schema", "README.md", "SPEC.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node scripts/lint.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "schema": "node scripts/gen-schema.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
