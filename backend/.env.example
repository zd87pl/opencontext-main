# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info

# Database (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/opencontext

# Redis (optional: shared sessions and session keys across instances;
# without it both live in process memory)
REDIS_URL=redis://localhost:6379

# Google OAuth (optional: /auth/google answers 503 until all three are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT for API access (JWT_EXPIRES_IN: seconds or an `ms` string such as 24h, 7d)
JWT_SECRET=change-me-too
JWT_EXPIRES_IN=24h

# Managed wallets: 32 random bytes, hex encoded (openssl rand -hex 32).
# If unset, the key is derived from SESSION_SECRET.
WALLET_ENCRYPTION_KEY=

# Blockchain (wallet balance lookups)
BLOCKCHAIN_RPC_URL=https://sepolia.era.zksync.dev
PASSPORT_REGISTRY_ADDRESS=
CONTEXT_VAULT_ADDRESS=
PAYMENT_STREAM_ADDRESS=

# Frontend
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Stripe (test keys; USD -> USDC settlement is stubbed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
