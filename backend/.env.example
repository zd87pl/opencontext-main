# Server Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-session-secret-here

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/opencontext

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=https://testnet.era.zksync.dev
PRIVATE_KEY=your-deployer-private-key

# Smart Contract Addresses (from existing deployment)
PASSPORT_REGISTRY_ADDRESS=
CONTEXT_VAULT_ADDRESS=
PAYMENT_STREAM_ADDRESS=

# Frontend URLs
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Stripe Configuration (for Week 3-4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Coinbase Commerce (for Week 3-4)
COINBASE_COMMERCE_API_KEY=