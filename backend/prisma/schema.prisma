// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents authenticated users
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  avatar        String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  oauthAccounts OAuthAccount[]
  wallet        Wallet?
  content       Content[]
  purchases     Purchase[]
  sessions      Session[]
  contentKeyEscrow ContentKeyEscrow[]
  
  @@index([email])
}

// OAuth account linking
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // google, github, medium, etc.
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Managed wallet for users
model Wallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  address             String   @unique
  encryptedPrivateKey String   @db.Text // Encrypted with platform key
  type                WalletType @default(MANAGED)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([address])
}

enum WalletType {
  MANAGED    // Platform-managed wallet
  IMPORTED   // User's own wallet
}

// Content created by users
model Content {
  id               String   @id @default(uuid())
  userId           String
  title            String
  description      String?
  platform         String   // wordpress, static, medium, etc.
  platformId       String?  // ID on the original platform
  price            Decimal  @db.Decimal(10, 2)
  encryptedContent String   @db.Text // Encrypted content blob
  encryptedKey     String   @db.Text // Encrypted content key
  preview          String   @db.Text // Unencrypted preview
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user      User       @relation(fields: [userId], references: [id])
  purchases Purchase[]
  contentKeyEscrow ContentKeyEscrow[]
  
  @@index([userId])
  @@index([platform, platformId])
}

// Purchase records
model Purchase {
  id                String   @id @default(uuid())
  userId            String
  contentId         String
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")
  paymentMethod     String   // stripe, crypto, account_balance
  transactionId     String?  // External transaction ID
  status            PurchaseStatus
  accessGranted     Boolean  @default(false)
  accessExpiresAt   DateTime?
  createdAt         DateTime @default(now())
  
  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
  
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Session management (for session-based auto-decryption)
model Session {
  id            String   @id @default(uuid())
  userId        String
  sessionKey    String   @unique
  encryptedData String?  @db.Text // Encrypted session data
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionKey])
  @@index([expiresAt])
}

// API keys for developers/AI agents
model ApiKey {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  userId      String
  permissions String[] // Array of permission strings
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  
  @@index([key])
  @@index([userId])
}

// Content Key Escrow - secure storage of encrypted content keys for session-based access
model ContentKeyEscrow {
  id                   String   @id @default(uuid())
  contentId            String
  userId               String
  encryptedContentKey  String   @db.Text // Content key encrypted with user's session key
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([contentId, userId]) // One escrow record per content per user
  @@index([userId])
  @@index([contentId])
  @@index([expiresAt])
}