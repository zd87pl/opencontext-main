// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents authenticated users
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  avatar        String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  oauthAccounts OAuthAccount[]
  wallet        Wallet?
  content       Content[]
  purchases     Purchase[]
  sessions      Session[]
  contentKeyEscrow ContentKeyEscrow[]
  aiAgents      AIAgent[]
  userPreferences UserPreferences?
  userLearningData UserLearningData?
  balanceTransactions BalanceTransaction[]
  revenues      Revenue[]
  analyticsEvents AnalyticsEvent[]
  
  // Account balance for micropayments
  accountBalance Decimal @default(0) @db.Decimal(10, 2)
  totalEarnings  Decimal @default(0) @db.Decimal(10, 2)
  
  @@index([email])
}

// OAuth account linking
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // google, github, medium, etc.
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Managed wallet for users
model Wallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  address             String   @unique
  encryptedPrivateKey String   @db.Text // Encrypted with platform key
  type                WalletType @default(MANAGED)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([address])
}

enum WalletType {
  MANAGED    // Platform-managed wallet
  IMPORTED   // User's own wallet
}

// Content created by users
model Content {
  id               String   @id @default(uuid())
  userId           String
  title            String
  description      String?
  platform         String   // wordpress, static, medium, etc.
  platformId       String?  // ID on the original platform
  price            Decimal  @db.Decimal(10, 2)
  encryptedContent String   @db.Text // Encrypted content blob
  encryptedKey     String   @db.Text // Encrypted content key
  preview          String   @db.Text // Unencrypted preview
  published        Boolean  @default(false)
  accessCount      Int      @default(0) // Track access for analytics
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user      User       @relation(fields: [userId], references: [id])
  purchases Purchase[]
  contentKeyEscrow ContentKeyEscrow[]
  
  @@index([userId])
  @@index([platform, platformId])
}

// Purchase records
model Purchase {
  id                String   @id @default(uuid())
  userId            String
  contentId         String
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")
  paymentMethod     String   // stripe, crypto, account_balance
  transactionId     String?  // External transaction ID
  status            PurchaseStatus
  accessGranted     Boolean  @default(false)
  accessExpiresAt   DateTime?
  metadata          Json?    // Additional metadata (agent_id, etc.)
  createdAt         DateTime @default(now())
  
  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])
  
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Session management (for session-based auto-decryption)
model Session {
  id            String   @id @default(uuid())
  userId        String
  sessionKey    String   @unique
  encryptedData String?  @db.Text // Encrypted session data
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionKey])
  @@index([expiresAt])
}

// API keys for developers/AI agents
model ApiKey {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  userId      String
  permissions String[] // Array of permission strings
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  
  @@index([key])
  @@index([userId])
}

// Content Key Escrow - secure storage of encrypted content keys for session-based access
model ContentKeyEscrow {
  id                   String   @id @default(uuid())
  contentId            String
  userId               String
  encryptedContentKey  String   @db.Text // Content key encrypted with user's session key
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([contentId, userId]) // One escrow record per content per user
  @@index([userId])
  @@index([contentId])
  @@index([expiresAt])
}

// AI Agents for MCP access
model AIAgent {
  id                String   @id @default(uuid())
  userId            String
  name              String
  description       String?
  apiKey            String   @unique
  secretKey         String   // For request signatures
  tier              String   @default("free") // free, pro, enterprise
  permissions       String[] // Allowed operations
  active            Boolean  @default(true)
  rateLimitHour     Int      @default(100)
  monthlySearchLimit Int     @default(1000) // -1 for unlimited
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([apiKey])
  @@index([tier])
}

// User preferences for personalization
model UserPreferences {
  id          String   @id @default(uuid())
  userId      String   @unique
  preferences Json     // Stores preference object
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Learning data for AI personalization
model UserLearningData {
  id           String   @id @default(uuid())
  userId       String   @unique
  learningData Json     // Stores learning patterns and feedback
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Balance transactions for account balance management
model BalanceTransaction {
  id           String   @id @default(uuid())
  userId       String
  type         String   // CREDIT, DEBIT
  amount       Decimal  @db.Decimal(10, 2)
  description  String
  balanceAfter Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Revenue tracking for creators
model Revenue {
  id          String   @id @default(uuid())
  userId      String   // Creator ID
  contentId   String
  amount      Decimal  @db.Decimal(10, 2) // Creator's share
  platformFee Decimal  @db.Decimal(10, 2) // Platform's share
  totalAmount Decimal  @db.Decimal(10, 2) // Original purchase amount
  type        String   @default("CONTENT_SALE")
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([contentId])
  @@index([createdAt])
}

// Analytics events for tracking usage
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String   // CONTENT_PURCHASE, CONTENT_ACCESS, TOOL_EXECUTION, etc.
  userId    String
  metadata  Json?    // Event-specific data
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([type])
  @@index([userId])
  @@index([createdAt])
}