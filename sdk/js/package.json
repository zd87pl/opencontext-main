{
  "name": "@opencontext/sdk",
  "version": "0.1.0",
  "description": "OpenContext Network JavaScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencontext",
    "web3",
    "ethereum",
    "zksync",
    "identity",
    "did"
  ],
  "author": "OpenContext Network",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.17.0",
    "kubo-rpc-client": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.13.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
